{
  "openapi": "3.0.3",
  "info": {
    "title": "BRUCE FIRE API",
    "version": "1.0.0",
    "description": "Especificación base de la API para el sistema de gestión de ventas de BRUCE FIRE S.A.C."
  },
  "servers": [
    {
      "url": "https://api.brucefire.local/api/v1",
      "description": "Servidor principal"
    }
  ],
  "paths": {
    "/health": {
      "get": {
        "summary": "Healthcheck del sistema",
        "operationId": "getHealth",
        "responses": {
          "200": {
            "description": "Estado del sistema",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/customers/export/pdf": {
      "get": {
        "summary": "Exportar clientes a PDF",
        "operationId": "exportCustomersPdf",
        "responses": {
          "200": {
            "description": "Archivo PDF generado"
          }
        }
      }
    },
    "/catalog/export/pdf": {
      "get": {
        "summary": "Exportar catálogo a PDF",
        "operationId": "exportCatalogPdf",
        "responses": {
          "200": {
            "description": "Archivo PDF generado"
          }
        }
      }
    },
    "/dashboard/metrics": {
      "get": {
        "summary": "Resumen de métricas del dashboard",
        "operationId": "getDashboardMetrics",
        "responses": {
          "200": {
            "description": "Métricas del sistema",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DashboardMetrics"
                }
              }
            }
          }
        }
      }
    },
    "/auth/change-password": {
      "post": {
        "summary": "Cambiar la contraseña del usuario autenticado",
        "operationId": "changePassword",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChangePasswordRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Contraseña actualizada correctamente"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "HealthResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "example": "ok"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          },
          "db_status": {
            "type": "string",
            "example": "connected"
          }
        }
      },
      "DashboardMetrics": {
        "type": "object",
        "properties": {
          "active_customers": {
            "type": "integer",
            "example": 180
          },
          "catalog_products": {
            "type": "integer",
            "example": 320
          },
          "users_by_role": {
            "type": "object",
            "additionalProperties": {
              "type": "integer"
            }
          }
        }
      },
      "ChangePasswordRequest": {
        "type": "object",
        "required": ["current_password", "new_password", "confirm_password"],
        "properties": {
          "current_password": {
            "type": "string",
            "example": "oldPassword123"
          },
          "new_password": {
            "type": "string",
            "example": "newPassword456"
          },
          "confirm_password": {
            "type": "string",
            "example": "newPassword456"
          }
        }
      }
    }
  }
}
